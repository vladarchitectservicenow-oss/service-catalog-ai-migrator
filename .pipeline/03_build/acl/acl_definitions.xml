  <!-- REST Endpoint: POST /api/x_nacl/execute — admin only -->
  <sys_security_acl>
    <active>true</active>
    <admin_overrides>true</admin_overrides>
    <advanced>false</advanced>
    <condition/>
    <description>Allow x_nacl.admin to execute POST /api/x_nacl/execute</description>
    <name>x_nacl_execute</name>
    <operation>
      <insert>false</insert>
      <delete>false</delete>
      <read>false</read>
      <write>false</write>
      <execute>true</execute>
    </operation>
    <script/>

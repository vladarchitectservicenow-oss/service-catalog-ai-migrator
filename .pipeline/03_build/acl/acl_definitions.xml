  <!-- x_nacl_interaction_log — Read ACL (admin + user) -->
  <sys_security_acl>
    <active>true</active>
    <admin_overrides>true</admin_overrides>
    <advanced>false</advanced>
    <condition/>
    <description>Allow x_nacl.admin and x_nacl.user to read interaction logs</description>
    <name>x_nacl_interaction_log</name>
    <operation>
      <insert>false</insert>
      <delete>false</delete>
      <read>true</read>
      <write>false</write>
    </operation>
    <script/>
    <sys_scope>x_nacl</sys_scope>
    <type>record</type>
    <requires_role>true</requires_role>
  </sys_security_acl>
  <sys_security_acl_role>
    <sys_scope>x_nacl</sys_scope>
    <name>x_nacl.admin</name>
    <sys_security_acl>x_nacl_interaction_log</sys_security_acl>
  </sys_security_acl_role>
  <sys_security_acl_role>
    <sys_scope>x_nacl</sys_scope>
    <name>x_nacl.user</name>
    <sys_security_acl>x_nacl_interaction_log</sys_security_acl>
  </sys_security_acl_role>

  <!-- x_nacl_interaction_log — Write ACL (admin only) -->
  <sys_security_acl>
    <active>true</active>
    <admin_overrides>true</admin_overrides>
    <advanced>false</advanced>
    <condition/>
    <description>Allow x_nacl.admin to create/update/delete interaction logs</description>
    <name>x_nacl_interaction_log_write</name>
    <operation>
      <insert>true</insert>
      <delete>true</delete>
      <read>false</read>
      <write>true</write>
    </operation>
    <script/>
    <sys_scope>x_nacl</sys_scope>
    <type>record</type>
    <requires_role>true</requires_role>
  </sys_security_acl>
  <sys_security_acl_role>
    <sys_scope>x_nacl</sys_scope>
    <name>x_nacl.admin</name>
    <sys_security_acl>x_nacl_interaction_log_write</sys_security_acl>
  </sys_security_acl_role>


  <!-- Business Rule: SKB Validate Config -->
  <sys_script action="INSERT_OR_UPDATE">
    <abort_action>true</abort_action>
    <access>package_private</access>
    <action_delete>false</action_delete>
    <action_insert>true</action_insert>
    <action_query>false</action_query>
    <action_update>true</action_update>
    <active>true</active>
    <add_message>true</add_message>
    <advanced>true</advanced>
    <change_fields>false</change_fields>
    <client_callable>false</client_callable>
    <collection>x_snc_skb_scan_config</collection>
    <condition/>
    <description>Validate artifact_types contains only valid types</description>
    <execute_function>false</execute_function>
    <filter_condition/>
    <is_rest>false</is_rest>
    <message>Invalid artifact type in configuration. Valid types: sys_script, sys_script_include, sys_ui_action, sys_ui_client_script, sys_ui_policy, sys_security_acl, sys_rest_message, sys_ws_definition, sysauto_script, sys_hub_flow</message>
    <name>SKB Validate Config</name>
    <order>100</order>
    <priority>100</priority>
    <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var validTypes = [
        'sys_script', 'sys_script_include', 'sys_ui_action',
        'sys_ui_client_script', 'sys_ui_policy', 'sys_security_acl',
        'sys_rest_message', 'sys_ws_definition', 'sysauto_script',
        'sys_hub_flow'
    ];

    var types = (current.artifact_types || '').split(',').map(function(t) {
        return t.trim();
    });

    for (var i = 0; i < types.length; i++) {
        if (types[i] && validTypes.indexOf(types[i]) === -1) {
            gs.addErrorMessage('Invalid artifact type: ' + types[i]);
            current.setAbortAction(true);
            return;
        }
    }
})(current, previous);]]></script>

  <!-- Business Rule: SKB Snapshot Name Unique -->
  <sys_script action="INSERT_OR_UPDATE">
    <abort_action>true</abort_action>
    <access>package_private</access>
    <action_delete>false</action_delete>
    <action_insert>true</action_insert>
    <action_query>false</action_query>
    <action_update>false</action_update>
    <active>true</active>
    <add_message>true</add_message>
    <advanced>true</advanced>
    <change_fields>false</change_fields>
    <client_callable>false</client_callable>
    <collection>x_snc_skb_skill_snapshot</collection>
    <condition/>
    <description>Ensure snapshot_name is unique per user</description>
    <execute_function>false</execute_function>
    <filter_condition/>
    <is_rest>false</is_rest>
    <message>A snapshot with this name already exists. Please choose a different name.</message>
    <name>SKB Snapshot Name Unique</name>
    <order>100</order>
    <priority>100</priority>
    <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var gr = new GlideRecord('x_snc_skb_skill_snapshot');
    gr.addQuery('snapshot_name', current.snapshot_name);
    gr.addQuery('scanned_by', gs.getUserName());
    gr.setLimit(1);
    gr.query();
    if (gr.next()) {
        gs.addErrorMessage('A snapshot named "' + current.snapshot_name + '" already exists. Please choose a different name.');
        current.setAbortAction(true);
    }
})(current, previous);]]></script>

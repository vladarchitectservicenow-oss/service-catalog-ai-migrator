  <!-- ============ x_sncf_catalog_forge_draft ============ -->
  <sys_security_acl action="INSERT_OR_UPDATE">
    <active>true</active>
    <name>x_sncf_catalog_forge_draft</name>
    <operation>read</operation>
    <script><![CDATA[(function evaluate() {
    // admin / mapper / viewer can read drafts; the requestor can read their own.
    if (gs.hasRole('x_sncf.admin') || gs.hasRole('x_sncf.mapper') || gs.hasRole('x_sncf.viewer')) { return true; }
    if (current.requestor == gs.getUserID()) { return true; }
    return false;
})();]]></script>
    <type>record</type>
    <sys_created_by>admin</sys_created_by>
    <sys_created_on>2026-09-22 05:10:00</sys_created_on>
    <sys_id>cf_acl_draft_read</sys_id>
    <sys_name>x_sncf_catalog_forge_draft.read</sys_name>
    <sys_package display_value="CatalogForge" source="x_sncf">CatalogForge</sys_package>
    <sys_update_name>sys_security_acl_cf_acl_draft_read</sys_update_name>
    <sys_updated_by>admin</sys_updated_by>
    <sys_updated_on>2026-09-22 05:10:00</sys_updated_on>
  </sys_security_acl>
  <sys_security_acl action="INSERT_OR_UPDATE">
    <active>true</active>
    <name>x_sncf_catalog_forge_draft</name>
    <operation>write</operation>
    <requires_role>false</requires_role>
    <script><![CDATA[(function evaluate() {
    if (gs.hasRole('x_sncf.admin') || gs.hasRole('x_sncf.mapper')) { return true; }
    return false;
})();]]></script>
